# Copy to modsync.properties, fill in, upload to /home/container/ via SFTP.
# This file holds the token and must NOT go in the public repo.

# GitHub repo that receives the trigger, "owner/name".
github.repo=YOUR_USER/digbuild-mods

# Fine-grained PAT, scoped to that ONE repo, permission: Contents = read/write.
# If this server is compromised, this token is the entire blast radius.
github.token=github_pat_xxxxxxxx

# Custom event name; must match the workflow's repository_dispatch type.
github.event_type=mods-changed

# The agent checks mods/ ONCE per boot (mods only load on restart anyway).
# This is just a settle delay before that check, in seconds.
startup.delay.seconds=10

# Paths inside the container. Defaults are correct for PebbleHost.
mods.dir=/home/container/mods
state.file=/home/container/.modsync-hash
log.file=/home/container/modsync.log
