# The mirror is 466MB and lives in the Actions cache, never in git.
mods/
mods-latest.zip
CHANGES.md

# Agent build artifacts and the real (secret-bearing) config.
agent/build/
agent/modsync-agent.jar
agent/modsync.properties

# local script caches (map jar downloads, bytecode)
__pycache__/
.cache/

# spark output. Heap summaries and profiles are pulled off the server to be
# read locally; they are megabytes each and their metadata carries the JVM
# command line, which names the host's internal server id.
*.sparkheap
*.sparkprofile

# patch/ build inputs and outputs. lib/ is 14MB of jars pulled off the server
# to compile against -- build_mod.py re-fetches whatever is missing.
patch/lib/
patch/build/
patch/digbuild-heappatch-*.jar

# tweaks/ builds against the same patch/lib cache.
tweaks/build/
tweaks/digbuild-tweaks-*.jar

# agent build outputs / local-only
agent/digbuild-modsync-*.jar
agent/forgelib
agent/pack.mcmeta

# sync/ pulls its own compile-only jars off the server, same as patch/.
sync/lib/
sync/build/
sync/digbuild-sync-*.jar
